PORT=4000
DATABASE_URL=postgresql://salmon:salmon@localhost:5432/salmon
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
WEB_BASE_URL=http://localhost:3000
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-revalidate

# Object storage (MinIO in dev, Cloudflare R2 in prod)
# Leave R2_ACCOUNT_ID empty in dev (uses S3_ENDPOINT); set it in prod to use Cloudflare R2
R2_ACCOUNT_ID=
S3_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=salmon
R2_SECRET_ACCESS_KEY=salmon-secret
R2_BUCKET_MEDIA=blog-media
R2_BUCKET_WIDGETS=blog-widgets
R2_BUCKET_PRIVATE=blog-private
R2_PUBLIC_MEDIA_URL=http://localhost:9000/blog-media
R2_PUBLIC_WIDGETS_URL=http://localhost:9000/blog-widgets

# Login attempts per minute per IP (default 5). Raise only for automated tests.
# LOGIN_RATE_LIMIT=5

# Optional error reporting (backend)
# SENTRY_DSN=
